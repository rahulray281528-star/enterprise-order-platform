<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="001-create-payments" author="platform">
        <comment>
            order_id is UNIQUE on purpose: it is the idempotency key that makes a
            redelivered OrderCreatedEvent unable to charge a customer twice.
        </comment>
        <createTable tableName="payments">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="VARCHAR(36)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_payments_order"/>
            </column>
            <column name="customer_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="gateway_reference" type="VARCHAR(64)"/>
            <column name="failure_reason" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addCheckConstraint tableName="payments" constraintName="ck_payments_amount_positive"
                            checkCondition="amount &gt; 0"/>

        <createIndex tableName="payments" indexName="idx_payments_order">
            <column name="order_id"/>
        </createIndex>
        <createIndex tableName="payments" indexName="idx_payments_customer">
            <column name="customer_id"/>
        </createIndex>
        <createIndex tableName="payments" indexName="idx_payments_status">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropTable tableName="payments"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
