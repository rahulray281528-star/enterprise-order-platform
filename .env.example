# Copy to .env and adjust as needed:   cp .env.example .env
# docker compose reads .env automatically. Every value below has a working default,
# so the platform starts even if you skip this file entirely.

# ---- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- Redis ---------------------------------------------------------------
REDIS_PORT=6379

# ---- Kafka ---------------------------------------------------------------
KAFKA_PORT=9092

# ---- Security ------------------------------------------------------------
# MUST be at least 32 characters (HS256 requires a 256-bit key).
# Generate a real one for anything non-local:  openssl rand -base64 48
JWT_SECRET=local-development-only-secret-change-me-in-production-0123456789
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ---- Payment gateway simulation -----------------------------------------
# Orders at or above this total are declined, which exercises the failure and
# inventory-release path. See README "Demonstrating the failure path".
PAYMENT_DECLINE_AT_OR_ABOVE=200000.00
PAYMENT_GATEWAY_LATENCY_MS=250

# ---- Logging -------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
